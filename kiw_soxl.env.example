# ── 운영 모드 ──────────────────────────────
# REAL=실전투자 / MOCK=모의투자
TRADE_MODE=MOCK

# ── 실전투자 (키움 REST API — openapi.kiwoom.com 에서 발급) ──
KIWOOM_APP_KEY=여기에_실전_앱키
KIWOOM_SECRET_KEY=여기에_실전_시크릿키
KIWOOM_ACCOUNT_NO=여기에_실전_계좌번호

# ── 모의투자 ───────────────────────────────
KIWOOM_APP_KEY_MOCK=여기에_모의_앱키
KIWOOM_SECRET_KEY_MOCK=여기에_모의_시크릿키
KIWOOM_ACCOUNT_NO_MOCK=여기에_모의_계좌번호

# ── 텔레그램 ───────────────────────────────
# ⚠️ 종가베팅/장중단타/무한매매 봇과 반드시 다른 새 봇(BotFather)으로 발급하세요
TELEGRAM_BOT_TOKEN=여기에_텔레그램_봇_토큰
TELEGRAM_CHAT_ID=여기에_chat_id
TELEGRAM_ENABLED=true

# ── 성과보고 이메일 (선택) ─────────────────
# 계정만 넣고, 켜기/끄기는 텔레그램 📧 이메일보고 버튼 (EMAIL_ENABLED 는 첫 기동 때 초기값으로만 사용)
# Gmail: Google 계정 → 보안 → 2단계 인증 → '앱 비밀번호' 16자리를 SMTP_PASSWORD 에 입력
# 네이버: 메일 환경설정 → POP3/IMAP 사용 → SMTP_HOST=smtp.naver.com, SMTP_PORT=465
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=보내는계정@gmail.com
SMTP_PASSWORD=앱비밀번호16자리
EMAIL_TO=받는주소@gmail.com

# ── 안전장치 ───────────────────────────────
# true: 키움에 실제 주문을 보내지 않고 봇 내부 가상 계좌로 체결을 흉내냅니다 (시세·차트는 실제 조회)
# 최소 1~2주 운영 후 false 전환 권장. 원장은 run/dry · run/mock · run/real 로 따로 보관됩니다.
DRY_RUN=true

BOT_LABEL="키움 해외주식 SOXL 스나이퍼 봇 #1 (KIW_SOXL)"
LOG_LEVEL=INFO
